      "expect": {
        "intent": "optimize",
        "task_types": ["optimize"],
        "params": {"budget_units": 2},
        "numeric_consistent": true,
        "demo_disclosed": true
      }
    },
    {
      "case_id": "V2-P-03",
      "group": "plan",
      "capability": "compare",
      "turns": [{"user": "比较需求比例0.2和0.4这两种情景的覆盖差异。"}],
      "expect": {
        "intent": "compare",
        "task_types": ["compare"],
        "numeric_consistent": true,
        "demo_disclosed": true
      }
    },
    {
      "case_id": "V2-P-04",
      "group": "plan",
      "capability": "sensitivity",
      "turns": [{"user": "预算0、1、2三档做敏感性分析，候选措施：给 zs_fed820d94e 扩容300人，成本1。"}],
      "expect": {
        "intent": "sensitivity",
        "task_types": ["sensitivity"],
        "numeric_consistent": true,
        "demo_disclosed": true
      }
    },
    {
      "case_id": "V2-P-05",
      "group": "plan",
      "capability": "diagnose",
      "turns": [{"user": "很多需求点没有被服务到，帮我做一次瓶颈诊断，看看原因。"}],
      "expect": {
